{
    "compilerOptions": {
        "target": "es2025",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": [
            "es2022",
            "dom"
        ],
        "rootDir": "./src/ts",
        "outDir": "./src/js",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": false,
        "allowJs": true
    },
    "include": [
        "src/ts/**/*"
    ],
    "exclude": [
        "node_modules",
        "src/js"
    ]
}